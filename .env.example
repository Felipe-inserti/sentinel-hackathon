# Sentinel - variaveis de ambiente
#
# Copie para `.env` (nunca commitar o `.env` real) ou exporte no shell/CI.
# Lido por `config.py` (pydantic-settings) para tudo relacionado a
# infraestrutura GCP e modelo; CERTSTREAM_URL e LOG_LEVEL sao lidos
# diretamente por `plane1_ingestion/ct_listener.py`.

# --- GCP ---------------------------------------------------------------
GCP_PROJECT_ID=meu-projeto-gcp
GCP_LOCATION=us-central1

# --- Modelo Gemini (Vertex AI) ------------------------------------------
# OBRIGATORIO, sem default no codigo -- o ID de modelo muda com frequencia
# e nao deve ser chutado. Confirme o identificador exato e disponivel na
# sua regiao no Vertex AI Model Garden (console) ou com:
#   gcloud ai models list --region=$GCP_LOCATION --project=$GCP_PROJECT_ID
# antes de subir para producao. No momento em que este arquivo foi escrito
# a documentacao publica trazia sinais conflitantes sobre qual e o Flash
# GA mais recente (candidatos vistos: gemini-3-flash-preview,
# gemini-3.1-flash-lite, gemini-3.6-flash) -- valide antes de usar.
GEMINI_MODEL_ID=gemini-3.6-flash

# --- Comportamento -------------------------------------------------------
# DRY_RUN=true e o padrao e deve continuar assim fora de producao. Acoes
# externas (ex: envio de notificacao de takedown) so devem executar de
# verdade com DRY_RUN=false explicito.
DRY_RUN=true

# --- Firestore -----------------------------------------------------------
FIRESTORE_COLLECTION=investigations

# --- Pub/Sub ---------------------------------------------------------------
SUSPICIOUS_TOPIC_ID=suspicious-domain-detected
COMPLETED_TOPIC_ID=investigation-completed
ORCHESTRATOR_SUBSCRIPTION_ID=sub-orchestrator

# --- evidence_agent.py (Sprint 4) ------------------------------------------
EVIDENCE_SUBSCRIPTION_ID=sub-evidence
# Sem default fixo no codigo (ver config.py) -- calculado como
# "{GCP_PROJECT_ID}-sentinel-evidence" se nao setado aqui. So preencha se
# esse nome colidir com um bucket ja existente (nomes de bucket GCS sao
# globalmente unicos).
# EVIDENCE_GCS_BUCKET=

# --- Plano 1 (ingestao, fora do config.py) --------------------------------
CERTSTREAM_URL=wss://certstream.calidog.io
LOG_LEVEL=INFO

# --- Telemetria (ver telemetry.py) ----------------------------------------
# OTEL_ENABLED=false para testes locais/CI -- pula toda a configuracao do
# exportador OTLP (nenhum canal gRPC/ADC e aberto). Com true (default),
# falha de autenticacao/rede so loga e segue sem exportar (nunca derruba
# o processo) -- mas exige `gcloud auth application-default login` (ou uma
# service account com os papeis certos, ver scripts/setup_gcp.sh) para
# realmente aparecer no Cloud Trace/Monitoring.
OTEL_ENABLED=true

# Preco por 1M de tokens (USD) usado so para estimar custo -- nao vem de
# nenhuma API de billing. Os defaults abaixo sao o preco promocional
# oficial do gemini-3.6-flash (valido ate 2026-12-31, ver
# ai.google.dev/gemini-api/docs/pricing). Se GEMINI_MODEL_ID for outro
# modelo, ajuste os dois valores abaixo tambem.
GEMINI_INPUT_PRICE_PER_MILLION_USD=0.75
GEMINI_OUTPUT_PRICE_PER_MILLION_USD=3.75

METRICS_FIRESTORE_COLLECTION=metrics

# --- Agent Registry (ver registry.py) -------------------------------------
AGENT_REGISTRY_COLLECTION=agent_registry

# --- takedown_agent.py (Sprint 6) ------------------------------------------
TAKEDOWN_SUBSCRIPTION_ID=sub-takedown
TAKEDOWN_ACTIONS_COLLECTION=takedown_actions
TAKEDOWN_RATE_LIMIT_COLLECTION=takedown_rate_limits
TAKEDOWN_DAILY_RATE_LIMIT_PER_BRAND=20
# Sem default -- endereco do time interno de Brand Security, especifico da
# organizacao. Sem isso, o canal BRAND_SECURITY_TEAM fica indisponivel
# (rejeitado com log de seguranca se o modelo tentar selecioná-lo).
# BRAND_SECURITY_TEAM_EMAIL=
